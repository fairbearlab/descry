#!/usr/bin/env bash
# env-check: verify a descry checkout before installing or editing.
#
# Checks local tool pins against CI, that you are in a git worktree, that the
# test harness is complete, and that no Compose files appear without a
# per-worktree project name. Prints one line per check:
#   PASS|FAIL|WARN|SKIP <id>: <reason>
# and a summary line. Exit 0 when nothing FAILed, 1 on any FAIL, 2 on a usage
# error. Reads every version from files at run time; runs offline.
#
# Written for bash 3.2 (macOS /bin/bash): no arrays, no mapfile, no
# associative arrays, POSIX sed/awk/grep only.

set -u -o pipefail

usage() {
  cat <<'USAGE'
usage: bin/env-check [--static]

  --static    file-only checks (no installed-tool probes, no worktree check)
  -h, --help  show this help

Environment:
  ENV_CHECK_ALLOW_MAIN=1  downgrade the main-checkout FAIL to a WARN
                          (for a single plain clone)
USAGE
}

mode=full
for arg in "$@"; do
  case $arg in
    --static) mode=static ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "env-check: unknown option: $arg" >&2
      usage >&2
      exit 2
      ;;
  esac
done

# Never download a toolchain or read a go.work from a parent directory.
export GOTOOLCHAIN=local GOWORK=off

nfail=0
nwarn=0
npass=0
nskip=0

emit() { # status id reason
  case $1 in
    FAIL) nfail=$((nfail + 1)) ;;
    WARN) nwarn=$((nwarn + 1)) ;;
    PASS) npass=$((npass + 1)) ;;
    SKIP) nskip=$((nskip + 1)) ;;
  esac
  printf '%s %s: %s\n' "$1" "$2" "$3"
}

finish() {
  printf 'env-check: %d FAIL, %d WARN, %d PASS, %d SKIP\n' "$nfail" "$nwarn" "$npass" "$nskip"
  if [ "$nfail" -eq 0 ]; then exit 0; fi
  exit 1
}

top=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$top" ]; then
  emit FAIL git "not inside a git work tree"
  finish
fi
cd "$top" || {
  emit FAIL git "cannot enter $top"
  finish
}

# yval KEY: read lines on stdin, print the tokenized value of KEY for each line
# that has it. The key needs a left boundary of line start, whitespace, "{" or
# ","; the value runs to the first ",", "}" or "#", is trimmed, and loses one
# pair of surrounding quotes. Works for block and flow style YAML.
yval() {
  sed -n -e "s/^\\(.*[[:space:]{,]\\)\\{0,1\\}$1:[[:space:]]*\\([^,}#]*\\).*\$/\\2/p" |
    sed -e 's/[[:space:]]*$//' -e "s/^'\\(.*\\)'\$/\\1/" -e 's/^"\(.*\)"$/\1/'
}

# step_window FILE ACTION: print the lines of the first step that has
# "uses: ACTION@", from the uses line until the next step (a line starting
# "- ") or a line indented less than the uses line. Comments and blank lines
# are skipped.
step_window() {
  awk -v act="$2@" '
    function ind(s) { match(s, /^[ \t]*/); return RLENGTH }
    st == 0 && index($0, "uses: " act) { st = 1; base = ind($0); print; next }
    st == 1 {
      if ($0 ~ /^[ \t]*$/ || $0 ~ /^[ \t]*#/) next
      if ($0 ~ /^[ \t]*-[ \t]/) exit
      if (ind($0) < base) exit
      print
    }
  ' "$1"
}

# step_version FILE ACTION: the first version: value inside the action's step.
step_version() {
  step_window "$1" "$2" | yval version | grep -v '^$' | head -1
}

tv() { # tool name in .tool-versions
  [ -f .tool-versions ] || return 0
  awk -v t="$1" '$1 == t { print $2; exit }' .tool-versions
}

# ---------------------------------------------------------------- (a) pins

# Effective CI Go: the toolchain line if present, else the go line. setup-go
# reads this through go-version-file: go.mod.
if [ -f go.mod ]; then
  gomod_ver=$(awk '$1 == "toolchain" { sub(/^go/, "", $2); print $2; exit }' go.mod)
  if [ -z "$gomod_ver" ]; then
    gomod_ver=$(awk '$1 == "go" { print $2; exit }' go.mod)
  fi
else
  gomod_ver=
fi

# pins-go-workflows
occ=
godirect=
for f in .github/workflows/*.yml .github/workflows/*.yaml; do
  [ -f "$f" ] || continue
  o=$(grep -nE '(^|[[:space:],{])go-version-file:' "$f" | grep -vE '^[0-9]+:[[:space:]]*#' |
    while IFS= read -r l; do
      v=$(printf '%s\n' "${l#*:}" | yval go-version-file | head -1)
      printf '%s:%s %s\n' "$f" "${l%%:*}" "$v"
    done)
  if [ -n "$o" ]; then
    occ="$occ$o
"
  fi
  g=$(grep -nE '(^|[[:space:],{])go-version:' "$f" | grep -vE '^[0-9]+:[[:space:]]*#' |
    while IFS= read -r l; do printf '%s:%s\n' "$f" "${l%%:*}"; done)
  if [ -n "$g" ]; then
    godirect="$godirect$g
"
  fi
done
if [ -z "$occ" ]; then
  emit FAIL pins-go-workflows "cannot parse: no go-version-file in workflows"
else
  bad=0
  nocc=0
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    nocc=$((nocc + 1))
    case $l in
      *" go.mod") ;;
      *)
        bad=1
        emit FAIL pins-go-workflows "${l% *} uses '${l#* }', want go.mod"
        ;;
    esac
  done <<EOF_OCC
$occ
EOF_OCC
  while IFS= read -r l; do
    [ -n "$l" ] || continue
    bad=1
    emit FAIL pins-go-workflows "$l sets go-version; use go-version-file: go.mod"
  done <<EOF_DIRECT
$godirect
EOF_DIRECT
  if [ "$bad" -eq 0 ]; then
    emit PASS pins-go-workflows "$nocc setup-go steps read go.mod (go $gomod_ver)"
  fi
fi

# pins-tool-versions-go
tv_go=$(tv golang)
if [ -z "$tv_go" ]; then
  emit FAIL pins-tool-versions-go "cannot parse: no golang line in .tool-versions"
elif [ -z "$gomod_ver" ]; then
  emit FAIL pins-tool-versions-go "cannot parse: no go line in go.mod"
elif [ "$tv_go" = "$gomod_ver" ]; then
  emit PASS pins-tool-versions-go ".tool-versions golang $tv_go matches go.mod"
else
  msg=".tool-versions golang $tv_go != go.mod $gomod_ver; bump .tool-versions golang to $gomod_ver (dependabot bumps go.mod only)"
  if [ "$mode" = static ]; then
    emit WARN pins-tool-versions-go "$msg"
  else
    emit FAIL pins-tool-versions-go "$msg"
  fi
fi

# pins-golangci
tv_lint=$(tv golangci-lint)
ci_lint=
if [ -f .github/workflows/ci.yml ]; then
  ci_lint=$(step_version .github/workflows/ci.yml golangci/golangci-lint-action)
  ci_lint=${ci_lint#v}
fi
if [ -z "$ci_lint" ]; then
  emit FAIL pins-golangci "cannot parse: no golangci-lint-action version in ci.yml"
elif [ -z "$tv_lint" ]; then
  emit FAIL pins-golangci "cannot parse: no golangci-lint line in .tool-versions"
elif [ "$ci_lint" = "$tv_lint" ]; then
  emit PASS pins-golangci "ci.yml and .tool-versions agree on golangci-lint $tv_lint"
else
  emit FAIL pins-golangci "ci.yml pins golangci-lint $ci_lint but .tool-versions has $tv_lint"
fi

emit PASS pins-goreleaser "agreement across ci.yml/release.yml guarded by TestGoreleaserVersionPinned"

go_ok=1
if [ "$mode" = full ]; then
  # go-installed
  if ! command -v go >/dev/null 2>&1; then
    go_ok=0
    emit FAIL go-installed "go not found on PATH; asdf install / mise install"
  elif [ -z "$gomod_ver" ]; then
    go_ok=0
    emit FAIL go-installed "cannot parse: no go line in go.mod"
  else
    gov=$(go env GOVERSION 2>/dev/null | head -1)
    case $gomod_ver in
      *.*.*)
        if [ "$gov" = "go$gomod_ver" ]; then
          emit PASS go-installed "$gov"
        else
          go_ok=0
          emit FAIL go-installed "have '${gov:-none}', want go$gomod_ver; asdf install / mise install"
        fi
        ;;
      *)
        case $gov in
          "go$gomod_ver" | "go$gomod_ver".*)
            emit WARN go-installed "$gov; go.mod pins a minor only"
            ;;
          *)
            go_ok=0
            emit FAIL go-installed "have '${gov:-none}', want go$gomod_ver.x; asdf install / mise install"
            ;;
        esac
        ;;
    esac
  fi

  # golangci-installed
  if ! command -v golangci-lint >/dev/null 2>&1; then
    emit FAIL golangci-installed "golangci-lint not found on PATH; asdf install / mise install"
  else
    gl=$(golangci-lint version --short 2>/dev/null | head -1)
    if [ -z "$gl" ]; then
      gl=$(golangci-lint --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    fi
    gl=${gl#v}
    if [ -z "$tv_lint" ]; then
      emit FAIL golangci-installed "cannot parse: no golangci-lint line in .tool-versions"
    elif [ "$gl" = "$tv_lint" ]; then
      emit PASS golangci-installed "$gl"
    else
      emit FAIL golangci-installed "have '${gl:-unknown}', want $tv_lint; asdf install / mise install"
    fi
  fi

  # goreleaser-installed
  if ! command -v goreleaser >/dev/null 2>&1; then
    emit SKIP goreleaser-installed "goreleaser not installed (only needed for release-config changes)"
  else
    gr_pin=
    if [ -f .github/workflows/release.yml ]; then
      gr_pin=$(step_version .github/workflows/release.yml goreleaser/goreleaser-action)
      gr_pin=${gr_pin#v}
    fi
    gr_out=$(goreleaser --version 2>/dev/null)
    gr=$(printf '%s\n' "$gr_out" | grep 'GitVersion' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    if [ -z "$gr" ]; then
      gr=$(printf '%s\n' "$gr_out" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    fi
    if [ -z "$gr_pin" ]; then
      emit WARN goreleaser-installed "cannot parse goreleaser pin in release.yml"
    elif [ -z "$gr" ]; then
      emit WARN goreleaser-installed "goreleaser on PATH but its version is unreadable; CI pins $gr_pin"
    elif [ "$gr" = "$gr_pin" ]; then
      emit PASS goreleaser-installed "$gr"
    else
      emit WARN goreleaser-installed "have $gr, CI pins $gr_pin"
    fi
  fi

  emit SKIP ci-only-tools "yq, promtool, kubectl, kubeconform, benchstat are CI-only pins with no local pin file"
fi

# ---------------------------------------------------- (b) container guard

compose_re='(^|/)([^/]*\.)?(docker-)?compose(\.[^/]*)?\.ya?ml$'
compose_file=$(git ls-files 2>/dev/null | grep -E "$compose_re" | head -1)
if [ -z "$compose_file" ]; then
  emit SKIP containers "no Compose files in repo"
else
  emit FAIL containers "$compose_file is tracked but env-check has no container checks; extend bin/env-check"
fi

# ------------------------------------------------------- (c) worktree

if [ "$mode" = static ]; then
  emit SKIP worktree "--static"
else
  gd=$(cd "$(git rev-parse --git-dir)" 2>/dev/null && pwd -P)
  cd_=$(cd "$(git rev-parse --git-common-dir)" 2>/dev/null && pwd -P)
  if [ -n "$gd" ] && [ "$gd" != "$cd_" ]; then
    emit PASS worktree "linked worktree $(basename "$top")"
  elif [ "${ENV_CHECK_ALLOW_MAIN:-}" = 1 ]; then
    emit WARN worktree "main checkout (allowed by ENV_CHECK_ALLOW_MAIN=1)"
  else
    emit FAIL worktree "main checkout; create one with 'git worktree add ../descry-<topic>' (or set ENV_CHECK_ALLOW_MAIN=1 for a single plain clone)"
  fi
fi

# ------------------------------------------------------ (d) harness

if ! command -v git >/dev/null 2>&1; then
  emit FAIL harness-tools "git not found on PATH"
elif [ "$mode" = full ]; then
  missing=
  command -v go >/dev/null 2>&1 || missing="$missing go"
  command -v golangci-lint >/dev/null 2>&1 || missing="$missing golangci-lint"
  if [ -n "$missing" ]; then
    emit FAIL harness-tools "missing from PATH:$missing"
  else
    emit PASS harness-tools "git, go, golangci-lint on PATH"
  fi
else
  emit PASS harness-tools "git on PATH"
fi

files_bad=0
for f in go.mod go.sum .tool-versions .golangci.yml .github/workflows/ci.yml bin/env-check; do
  if ! git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
    files_bad=1
    emit FAIL harness-files "$f is not tracked"
  elif [ ! -f "$f" ]; then
    files_bad=1
    emit FAIL harness-files "$f is tracked but missing on disk"
  fi
done
deleted=$(git ls-files --deleted 2>/dev/null)
if [ -n "$deleted" ]; then
  files_bad=1
  ndel=$(printf '%s\n' "$deleted" | grep -c .)
  first=$(printf '%s\n' "$deleted" | head -5 | tr '\n' ' ')
  emit FAIL harness-files "$ndel tracked files deleted from the working tree: ${first% }"
fi
if [ "$files_bad" -eq 0 ]; then
  emit PASS harness-files "required files tracked and present, none deleted"
fi

emode=$(git ls-files -s bin/env-check 2>/dev/null | awk '{ print $1; exit }')
if [ "$emode" = 100755 ]; then
  emit PASS harness-exec-bit "bin/env-check is mode 100755"
else
  emit FAIL harness-exec-bit "bin/env-check git mode is '${emode:-untracked}', want 100755"
fi

if [ "$(git config --bool core.sparseCheckout 2>/dev/null)" = true ]; then
  emit WARN harness-sparse "core.sparseCheckout is on; some files may be absent"
else
  emit PASS harness-sparse "no sparse checkout"
fi

if [ "$mode" = full ]; then
  if [ "$go_ok" -eq 0 ]; then
    emit SKIP harness-modcache "Go version mismatch, see go-installed"
    emit SKIP harness-govulncheck "Go version mismatch, see go-installed"
  else
    if GOPROXY=off GOFLAGS=-mod=readonly go list -deps -test ./... >/dev/null 2>&1; then
      emit PASS harness-modcache "module cache complete"
    else
      emit WARN harness-modcache "module cache incomplete; run go mod download (needs network)"
    fi
    if GOPROXY=off GOFLAGS=-mod=readonly go tool -n govulncheck >/dev/null 2>&1; then
      emit PASS harness-govulncheck "govulncheck tool available"
    else
      emit WARN harness-govulncheck "go tool govulncheck unavailable offline; run go mod download (needs network)"
    fi
  fi
fi

# ------------------------------------------- (e) compose project name

if [ -z "$compose_file" ]; then
  emit SKIP compose-project "no Compose files in repo"
else
  emit FAIL compose-project "$compose_file tracked; derive COMPOSE_PROJECT_NAME from the worktree before adding it"
fi

finish
