# Compiled binary
/descry

# goreleaser output. goreleaser creates it before it builds, and Go stamps
# a build whose tree has an untracked file as dirty (+dirty,
# vcs.modified=true), so it must stay ignored for release binaries to read
# clean in `go version -m`.
/dist/

# Test coverage profile (written by the CI test command when run locally)
coverage.out

# Rule group extracted from contrib/prometheus/descry-rules.yaml for promtool
# (written by the CI rules job and by the commands in its README)
contrib/prometheus/descry-rules.extracted.yaml
